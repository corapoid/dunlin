s target:\n            target.write('write')\n        with open(created, 'w') as target:\n            target.write('write')\n\n# These files exist before sandbox startup. EPERM/EACCES proves an actual deny,\n# rather than a missing-path error or an assertion about profile text alone.\nfor label, path in (('source workspace', source_secret),\n                    ('other project', other_secret), ('relay DB', relay_db)):\n    denied(label + ' read', lambda: open(path, 'rb').read(1))\n    denied(label + ' append', lambda: open(path, 'ab').write(b'forbidden'))\nprint(json.dumps({'kernel': 'seatbelt', 'metadata': mode, 'protected_files': 3}))\n","process_home":"/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/server/agent-homes/usr-01a1cd76-a228-7218-b482-d323a502d5cf","profile_home":"/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/home","profiles":[{"args":["/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/home/Documents/source/.git","/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/home/Documents/source/.git/worktrees/checkout","/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/home/Documents/source/source-only-secret","/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/other-project/other-project-secret","/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/relay.db","read"],"cwd":"/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/checkout","permission":"read","profile":"(version 1)\n(allow default)\n(deny file-read* (require-all (subpath \"/Users/corapoid/git_priv/dunlin/target/web-checks/macos-metadata-3ec0cec96ecb4c3fa5428657cfaeef51/home/.ssh\") (require-not (subpath \"/Users/corapoid/gi