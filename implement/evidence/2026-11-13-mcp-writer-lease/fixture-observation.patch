+fn observe_writer(store: &Mutex<Store>, busy: bool) {
+    let deadline = std::time::Instant::now() + Duration::from_secs(2);
+    loop {
+        let observed = match store.try_lock() {
+            Ok(store) => Some(store.mcp_oauth_writer_lease().is_err()),
+            Err(std::sync::TryLockError::WouldBlock) => None,
+            Err(_) => panic!("Store poisoned during writer observation"),
+        };
+        if observed == Some(busy) {
+            return;
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "writer lease availability did not reach the expected state"
+        );
+        // Other controller/WS threads may briefly use Store. Drop its guard
+        // before waiting; the actual caller cannot finish its own private/MCP
+        // I/O until this hook returns, so an incorrectly held/missing lease
+        // still fails within the bound.
+        std::thread::sleep(Duration::from_millis(2));
+    }
