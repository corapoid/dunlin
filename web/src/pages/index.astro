---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import Bento from "../components/Bento.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Native from "../components/Native.astro";
import Remote from "../components/Remote.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { site } from "../lib/site";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Dunlin",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15+",
  processorRequirements: "Apple Silicon",
  description: site.description,
  url: Astro.site?.toString() ?? site.url,
  downloadUrl: site.downloadDmg,
  codeRepository: site.github,
  license: site.license,
  softwareVersion: site.version,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Base
  title="Dunlin — a native, agent-first IDE for macOS"
  description={site.description}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />
  <Hero />
  <TaglineReveal />
  <Bento />
  <HowItWorks />
  <Native />
  <Remote />
  <FAQ />
  <FinalCTA />
</Base>
