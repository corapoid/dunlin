---
interface Props {
  class?: string;
  index: string;
  title: string;
  description: string;
  dark?: boolean;
}

const {
  class: className = "",
  index,
  title,
  description,
  dark = false,
} = Astro.props;
---

<article
  class:list={[
    "relative flex flex-col overflow-hidden rounded-2xl border p-6 sm:p-8",
    dark
      ? "border-night-line bg-night text-paper-soft"
      : "border-line bg-paper-soft text-ink",
    className,
  ]}
  data-reveal
>
  <div class="flex items-start justify-between gap-4">
    <p
      class:list={[
        "font-mono text-[11px] uppercase tracking-[0.16em]",
        dark ? "text-paper/35" : "text-ink/35",
      ]}
    >
      {index}
    </p>
    <span class="mt-0.5 size-1.5 rounded-full bg-clay"></span>
  </div>

  <h3
    class:list={[
      "mt-8 font-serif text-3xl leading-[0.98] tracking-[-0.03em] sm:text-4xl",
      dark ? "text-paper-soft" : "text-ink",
    ]}
  >
    {title}
  </h3>
  <p
    class:list={[
      "mt-4 max-w-md text-sm leading-6",
      dark ? "text-paper/55" : "text-ink/62",
    ]}
  >
    {description}
  </p>

  <div class="mt-8 flex-1">
    <slot />
  </div>
</article>
